meta {
  name: List workflows
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/workflows
  body: none
  auth: none
}

docs {
  Returns all workflow definitions as a plain JSON array of `Workflow` objects.

  **v4.2.10:** This endpoint reverts to its pre-v4.2.8 lean shape — a bare
  `Workflow[]` array with no cost data, no wrapping, and no query parameters.
  For cost analytics (30-day totals, 1-year totals, daily buckets) use
  `GET /api/cost/workflows` instead (see `bruno/Cost/`).

  ## Response shape

  ```json
  [
    {
      "id": "01941234-5678-7abc-def0-123456789abc",
      "name": "nightly-analysis",
      "version": 1,
      "schedule": "0 2 * * *",
      "timezone": "America/New_York",
      "schedule_mode": "Cron",
      "enabled": true,
      "steps": [
        {
          "kind": "shell",
          "id": "fetch",
          "command": "git pull origin main",
          "pass_stdin": false,
          "on_failure": null,
          "always_run": false,
          "timeout_secs": 60,
          "working_dir": null,
          "env_vars": null,
          "capture": { "stdout_max_bytes": 65536, "parser": null }
        }
      ],
      "default_input": null,
      "working_dir": "/workspace",
      "env_vars": { "LANG": "en_US.UTF-8" },
      "allow_concurrent": true,
      "on_failure": "abort",
      "last_run_at": "2025-01-16T02:00:00Z",
      "last_run_status": "Completed",
      "last_run_id": "01941234-aaaa-7abc-def0-123456789abc",
      "next_run_at": "2025-01-17T02:00:00Z",
      "created_at": "2025-01-15T10:30:00Z",
      "updated_at": "2025-01-15T10:30:00Z"
    }
  ]
  ```
}
