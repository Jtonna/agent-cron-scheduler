meta {
  name: Get workflow
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/workflows/:id
  body: none
  auth: none
}

params:path {
  id: {{workflowId}}
}

docs {
  Returns one `Workflow` by UUID OR by name. Both forms work in the same path.

  - `GET /api/workflows/019df531-5c1d-7600-8801-3b1c7995e5a8`
  - `GET /api/workflows/weather-agent`

  404 if not found.

  **v4.2.10:** This endpoint returns a lean `Workflow` object with no `cost_summary`.
  For cost analytics (30-day totals, 1-year totals, daily buckets) use
  `GET /api/cost/workflows/:id` instead (see `bruno/Cost/`).

  ## Response shape

  ```json
  {
    "id": "019df531-5c1d-7600-8801-3b1c7995e5a8",
    "name": "weather-agent",
    "version": 3,
    "schedule": "0 8 * * *",
    "timezone": "America/Los_Angeles",
    "schedule_mode": "Cron",
    "enabled": true,
    "steps": [
      {
        "kind": "agent",
        "id": "fetch-weather",
        "agent_type": "claude_code_cli",
        "prompt": "Fetch the weather forecast for Seattle and summarize it.",
        "model": null,
        "extra_args": []
      }
    ],
    "default_input": null,
    "working_dir": "/home/user/Documents/agent-cron-scheduler/weather-agent",
    "env_vars": null,
    "allow_concurrent": false,
    "on_failure": "abort",
    "last_run_at": "2026-05-10T15:00:00Z",
    "last_run_status": "Completed",
    "last_run_id": "019df600-aaaa-7abc-def0-123456789abc",
    "next_run_at": "2026-05-11T15:00:00Z",
    "created_at": "2026-04-01T10:00:00Z",
    "updated_at": "2026-05-01T09:30:00Z"
  }
  ```
}
