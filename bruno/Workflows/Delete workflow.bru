meta {
  name: Delete workflow
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/workflows/:id
  body: none
  auth: none
}

params:path {
  id: {{workflowId}}
}

docs {
  Permanent delete. Returns 204 on success.

  Past run records under `runs/<workflow_id>/` and log files under
  `logs/<workflow_id>/` are NOT automatically deleted with the workflow —
  they remain for historical inspection until manually removed.

  **Side effects:** the workflow's cost-cache entry is evicted from the in-memory `CostCache`, and a `WorkflowChanged` SSE event with `change_kind: "deleted"` is broadcast to subscribers of `/api/events/workflows`.
}
