meta {
  name: Create — http step
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/workflows
  body: json
  auth: none
}

body:json {
  {
    "name": "ex-http",
    "schedule": "0 0 1 1 *",
    "enabled": false,
    "steps": [
      {
        "kind": "http",
        "id": "ping",
        "method": "GET",
        "url": "https://httpbin.org/get?source=acs",
        "headers": {
          "User-Agent": "ACS/${input.client_version}",
          "Accept": "application/json"
        },
        "expect_status": [200],
        "timeout_secs": 15
      }
    ],
    "default_input": {
      "client_version": "4.0.0"
    }
  }
}

docs {
  HTTP step example. Body, URL, and headers all support template substitution.

  - `expect_status` — list of HTTP status codes treated as success (exit 0).
    Anything else maps to exit code = HTTP status code.
  - When the response Content-Type is JSON, the body is parsed structurally
    so downstream `${steps.<id>.stdout.<field>}` paths can navigate it.
    Non-JSON bodies remain available as raw text via `${steps.<id>.stdout}`.
  - The full response body is also written to the run log file and is
    fetchable via `GET /api/runs/{run_id}/log?step_index=N`.
  - Kill is implemented by dropping the in-flight reqwest future via tokio::select!.
}
