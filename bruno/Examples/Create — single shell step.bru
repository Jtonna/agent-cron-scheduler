meta {
  name: Create — single shell step
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/workflows
  body: json
  auth: none
}

body:json {
  {
    "name": "ex-shell-hello",
    "schedule": "0 0 1 1 *",
    "enabled": false,
    "steps": [
      {
        "kind": "shell",
        "id": "main",
        "command": "echo hello from ACS",
        "timeout_secs": 30
      }
    ]
  }
}

docs {
  Smallest possible workflow: one shell step that prints a line.

  - Disabled — the cron scheduler will skip this workflow. Manual triggers via `POST /api/workflows/{id}/trigger` still work regardless of the `enabled` flag. Uses a sentinel "Jan 1, midnight" cron.
  - Default `allow_concurrent: true` (multiple manual triggers can overlap).
}
