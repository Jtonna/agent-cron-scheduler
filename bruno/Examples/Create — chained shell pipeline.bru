meta {
  name: Create — chained shell pipeline
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/workflows
  body: json
  auth: none
}

body:json {
  {
    "name": "ex-shell-pipeline",
    "schedule": "0 0 1 1 *",
    "enabled": false,
    "allow_concurrent": false,
    "steps": [
      {
        "kind": "shell",
        "id": "fetch",
        "command": "echo apple banana cherry"
      },
      {
        "kind": "shell",
        "id": "filter",
        "command": "echo \"${steps.fetch.stdout}\" | tr ' ' '\\n' | sort -r"
      },
      {
        "kind": "shell",
        "id": "count",
        "command": "echo \"${steps.filter.stdout}\" | wc -l"
      }
    ]
  }
}

docs {
  Three shell steps demonstrating template substitution between steps.

  - `${steps.fetch.stdout}` resolves to the prior step's captured stdout
    (capped by the step's `capture.stdout_max_bytes`, default 64 KB).
  - The full stdout/stderr stream is written to the run log file on disk;
    fetch it via `GET /api/runs/{run_id}/log?step_index=N`.
  - On Windows the inner shell quoting will differ — `cmd /C` rather than `sh -c`.
    Adjust to PowerShell `-Command` or use Script steps with `script_type: "shell"`
    if you need consistent quoting cross-platform.
}
