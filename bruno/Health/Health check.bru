meta {
  name: Health check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

docs {
  Returns daemon liveness, summary stats, and platform service registration.

  The `service` block reports whether ACS is registered with the platform
  service manager (Windows registry Run key, macOS launchd plist, or Linux
  systemd user unit). `service.details` is omitted when `registered` is false.

  Response 200 example:
  ```json
  {
    "status": "ok",
    "uptime_seconds": 1234,
    "active_jobs": 3,        // count of enabled workflows (legacy field name)
    "total_jobs": 7,         // count of all workflows (legacy field name)
    "version": "4.2.5",
    "data_dir": "C:\\Users\\J\\AppData\\Local\\agent-cron-scheduler",
    "service": {
      "registered": true,
      "platform": "windows",
      "details": "Registry: HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\AgentCronScheduler"
    }
  }
  ```
}
